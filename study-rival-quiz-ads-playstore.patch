+// ══════════════════════════════════════════════════════════════════════
+// PRACTICE QUIZ — Groq-powered similar-question generator with timed grading
+// BYOK: uses the user's own free Groq API key, stored locally, never bundled.
+// ══════════════════════════════════════════════════════════════════════
+const QUIZ_MODEL = 'llama-3.3-70b-versatile';
+const QUIZ_API_URL = 'https://api.groq.com/openai/v1/chat/completions';
+
+let _quizQueue = [];
+let _quizAsked = [];
+let _quizCurrent = null;
+let _quizTimerHandle = null;
+let _quizDeadline = 0;
+let _quizSeed = '';
+
+function renderQuizPage(){
+  const keyEl = document.getElementById('quizApiKeyInput');
+  const hasKey = !!(S.quiz && S.quiz.groqApiKey);
+  keyEl.value = '';
+  keyEl.placeholder = hasKey ? '•••••••••••••••••••• (saved)' : 'gsk_...';
+  document.getElementById('quizKeyStatus').textContent = hasKey ? '· saved' : '· not set';
+  document.getElementById('quizTimerInput').value = S.quiz.timerSec;
+  document.getElementById('quizBatchInput').value = S.quiz.batchSize;
+  document.getElementById('quizKeyDetails').open = !hasKey;
+  renderQuizHistory();
+}
+
+function saveQuizApiKey(){
+  const v = document.getElementById('quizApiKeyInput').value.trim();
+  if(!v){ notify('Enter a key first', 'warn'); return; }
+  S.quiz.groqApiKey = v;
+  save();
+  document.getElementById('quizApiKeyInput').value = '';
+  document.getElementById('quizKeyDetails').open = false;
+  renderQuizPage();
+  notify('Groq key saved locally on this device', 'good');
+}
+
+function clearQuizApiKey(){
+  S.quiz.groqApiKey = '';
+  save();
+  renderQuizPage();
+  notify('Groq key cleared', 'info');
+}
+
+async function quizApiCall(systemPrompt, userPrompt, temperature){
+  const key = S.quiz.groqApiKey;
+  if(!key) throw new Error('No Groq API key set — add one above.');
+  const res = await fetch(QUIZ_API_URL, {
+    method: 'POST',
+    headers: { 'Authorization': 'Bearer ' + key, 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      model: QUIZ_MODEL,
+      messages: [
+        { role: 'system', content: systemPrompt },
+        { role: 'user', content: userPrompt }
+      ],
+      temperature: temperature
+    })
+  });
+  if(!res.ok){
+    const t = await res.text().catch(()=>String(res.status));
+    throw new Error('Groq API error ' + res.status + ': ' + t.slice(0,200));
+  }
+  const data = await res.json();
+  let content = (data.choices[0].message.content || '').trim();
+  if(content.startsWith('```')){
+    content = content.replace(/^```[a-z]*\n?/,'').replace(/```$/,'').trim();
+  }
+  return content;
+}
+
+async function fetchQuizBatch(seed, exclude, n){
+  const excludeBlock = exclude.slice(-30).map(q=>'- '+q).join('\n') || '(none yet)';
+  const sys = 'You are a practice-question generator. Given a seed question, produce new questions '+
+    'that test the SAME concept/skill and SAME difficulty level, but are not near-duplicates of each '+
+    'other or of anything in the exclude list. For each question also give the correct answer/solution. '+
+    'Reply with ONLY a JSON array of objects shaped like {"question":"...","answer":"..."}, nothing else '+
+    '— no markdown fences, no commentary.';
+  const usr = 'Seed question:\n'+seed+'\n\nAlready asked (do not repeat these or close variants):\n'+excludeBlock+
+    '\n\nGenerate '+n+' new similar questions with answers, as a JSON array.';
+  const content = await quizApiCall(sys, usr, 0.8);
+  try{
+    const items = JSON.parse(content);
+    if(!Array.isArray(items)) throw 0;
+    return items.filter(it=>it && it.question).map(it=>({question:String(it.question).trim(), answer:String(it.answer||'').trim()}));
+  }catch(e){
+    return content.split('\n').filter(l=>l.trim()).map(l=>({question:l.replace(/^[-*]\s*/,'').trim(), answer:''}));
+  }
+}
+
+async function gradeQuizAnswer(question, modelAnswer, userAnswer){
+  if(!userAnswer) return 'No answer given.';
+  if(!modelAnswer) return '(no model answer available to grade against)';
+  const sys = 'You are a strict but fair grader. Given a question, the correct answer, and a student\'s '+
+    'answer, judge whether the student\'s answer is Correct, Partially correct, or Incorrect. Reply with '+
+    'ONLY the verdict word/phrase, a colon, then one short sentence of feedback. No extra commentary.';
+  const usr = 'Question: '+question+'\nCorrect answer: '+modelAnswer+'\nStudent\'s answer: '+userAnswer;
+  try{
+    return await quizApiCall(sys, usr, 0.2);
+  }catch(e){
+    return '(grading failed: '+e.message+')';
+  }
+}
+
+async function startQuizSession(){
+  const seed = document.getElementById('quizSeedInput').value.trim();
+  const errEl = document.getElementById('quizSetupError');
+  errEl.textContent = '';
+  if(!S.quiz.groqApiKey){ errEl.textContent = 'Add your Groq API key above first.'; return; }
+  if(!seed){ errEl.textContent = 'Paste a seed question first.'; return; }
+
+  S.quiz.timerSec = Math.max(10, Math.min(600, parseInt(document.getElementById('quizTimerInput').value)||90));
+  S.quiz.batchSize = Math.max(1, Math.min(10, parseInt(document.getElementById('quizBatchInput').value)||5));
+  save();
+
+  _quizSeed = seed;
+  _quizAsked = [];
+  _quizQueue = [];
+
+  document.getElementById('quizSetup').style.display = 'none';
+  document.getElementById('quizRunning').style.display = 'block';
+  document.getElementById('quizLoading').style.display = 'block';
+  document.getElementById('quizQuestionCard').textContent = '';
+
+  try{
+    _quizQueue = await fetchQuizBatch(_quizSeed, _quizAsked, S.quiz.batchSize);
+  }catch(e){
+    document.getElementById('quizLoading').style.display = 'none';
+    notify(e.message, 'bad');
+    endQuizSession();
+    return;
+  }
+  document.getElementById('quizLoading').style.display = 'none';
+  if(!_quizQueue.length){ notify('Model returned no questions — try a more specific seed.', 'bad'); endQuizSession(); return; }
+  quizNextQuestion();
+}
+
+async function quizNextQuestion(){
+  if(_quizTimerHandle) clearInterval(_quizTimerHandle);
+  document.getElementById('quizVerdict').style.display = 'none';
+  document.getElementById('quizNextBtn').style.display = 'none';
+  document.getElementById('quizAnswerInput').value = '';
+  document.getElementById('quizAnswerInput').disabled = false;
+
+  if(!_quizQueue.length){
+    document.getElementById('quizLoading').style.display = 'block';
+    try{
+      _quizQueue = await fetchQuizBatch(_quizSeed, _quizAsked, S.quiz.batchSize);
+    }catch(e){
+      document.getElementById('quizLoading').style.display = 'none';
+      notify(e.message, 'bad');
+      return;
+    }
+    document.getElementById('quizLoading').style.display = 'none';
+    if(!_quizQueue.length){ notify('No new questions came back.', 'bad'); return; }
+  }
+
+  _quizCurrent = _quizQueue.shift();
+  _quizAsked.push(_quizCurrent.question);
+  document.getElementById('quizQuestionCard').textContent = _quizCurrent.question;
+
+  _quizDeadline = Date.now() + S.quiz.timerSec*1000;
+  updateQuizTimerBar();
+  _quizTimerHandle = setInterval(updateQuizTimerBar, 1000);
+}
+
+function updateQuizTimerBar(){
+  const remaining = Math.max(0, Math.round((_quizDeadline - Date.now())/1000));
+  const m = String(Math.floor(remaining/60)).padStart(2,'0');
+  const s = String(remaining%60).padStart(2,'0');
+  document.getElementById('quizTimerBar').textContent = '⏳ ' + m + ':' + s;
+  if(remaining<=0){
+    clearInterval(_quizTimerHandle);
+    document.getElementById('quizAnswerInput').disabled = true;
+    submitQuizAnswer(true);
+  }
+}
+
+async function submitQuizAnswer(timedOut){
+  if(_quizTimerHandle) clearInterval(_quizTimerHandle);
+  const answer = timedOut ? '' : document.getElementById('quizAnswerInput').value.trim();
+  document.getElementById('quizAnswerInput').disabled = true;
+
+  const vEl = document.getElementById('quizVerdict');
+  vEl.style.display = 'block';
+  vEl.style.background = 'var(--log-bg)';
+  vEl.style.border = '1px solid var(--border)';
+  vEl.textContent = timedOut ? '⏰ Time\'s up — grading skipped.' : 'Grading...';
+
+  let verdict = timedOut ? 'Timed out — no answer given.' : await gradeQuizAnswer(_quizCurrent.question, _quizCurrent.answer, answer);
+  const lc = verdict.toLowerCase();
+  const good = lc.startsWith('correct');
+  const bad  = lc.startsWith('incorrect') || lc.startsWith('timed out') || lc.startsWith('no answer');
+  vEl.style.borderColor = good ? 'var(--good)' : bad ? 'var(--bad)' : 'var(--warn)';
+  vEl.textContent = verdict + (_quizCurrent.answer ? '\n\nModel answer: ' + _quizCurrent.answer : '');
+  vEl.style.whiteSpace = 'pre-wrap';
+
+  S.quiz._history = S.quiz._history || [];
+  S.quiz._history.unshift({
+    ts: Date.now(), question: _quizCurrent.question, answer: answer,
+    modelAnswer: _quizCurrent.answer, verdict: verdict
+  });
+  S.quiz._history = S.quiz._history.slice(0, 50);
+  save();
+
+  document.getElementById('quizNextBtn').style.display = 'block';
+  renderQuizHistory();
+}
+
+function endQuizSession(){
+  if(_quizTimerHandle) clearInterval(_quizTimerHandle);
+  document.getElementById('quizSetup').style.display = 'block';
+  document.getElementById('quizRunning').style.display = 'none';
+  _quizQueue = []; _quizAsked = []; _quizCurrent = null;
+}
+
+function renderQuizHistory(){
+  const el = document.getElementById('quizHistoryList');
+  const hist = (S.quiz && S.quiz._history) || [];
+  if(!hist.length){ el.textContent = 'No sessions yet.'; return; }
+  el.innerHTML = hist.slice(0,20).map(h=>{
+    const lc = (h.verdict||'').toLowerCase();
+    const color = lc.startsWith('correct') ? 'var(--good)' : (lc.startsWith('incorrect')||lc.startsWith('timed')||lc.startsWith('no answer')) ? 'var(--bad)' : 'var(--warn)';
+    return `<div style="padding:8px 0;border-bottom:1px solid var(--border);">
+      <div style="color:var(--ink);margin-bottom:3px;">${h.question}</div>
+      <div style="color:${color};font-weight:700;">${h.verdict}</div>
+    </div>`;
+  }).join('');
+}
+
 init().catch(e=>{ console.error('Fatal init error:', e); notify('Startup error — check console.','bad'); });
 </script>
 </body>
